# MWAHLI production environment template
# Copy to .env.local for local development or inject these through your host/secret manager.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=MWAHLI
SESSION_SECRET=replace-with-64-plus-random-characters
# 32 random bytes encoded as base64. ENCRYPTION_KEY is accepted as a backwards-compatible alias.
APP_DATA_ENCRYPTION_KEY=
ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=

# Database / cache
DATABASE_URL=postgresql://mwahli:mwahli@localhost:5432/mwahli
DB_POOL_MAX=12
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
REDIS_URL=redis://localhost:6380
PGVECTOR_ENABLED=true

# Search
SEARCH_URL=http://localhost:9200
SEARCH_INDEX=mwahli-catalog
SEARCH_INDEX_PREFIX=mwahli
SEARCH_USERNAME=
SEARCH_PASSWORD=

# Private media / CDN
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=mwahli-private
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio123
OBJECT_STORAGE_FORCE_PATH_STYLE=true
CDN_URL=
MEDIA_MAX_BYTES=20000000
# Scanner endpoint should accept {bucket,key} and return {state:"clean"|"infected"|"blocked"}.
MEDIA_SCAN_URL=
MEDIA_SCAN_TOKEN=
# Backwards-compatible aliases accepted by worker/config.
MALWARE_SCANNER_URL=
MEDIA_MODERATION_PROVIDER=
MEDIA_MODERATION_API_KEY=
KMS_PROVIDER=
KMS_KEY_ID=

# Identity
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_REQUIRE_ADMIN_MFA=true
ADMIN_MFA_REQUIRED=true
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_RP_NAME=MWAHLI
AUTH_MFA_ISSUER=MWAHLI

# AI - OpenAI-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SAFETY_MODEL=
OPENAI_MAX_MONTHLY_USD=0

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MOMO_PROVIDER=
MOMO_API_URL=
MOMO_API_KEY=
MOMO_WEBHOOK_SECRET=

# KYC
KYC_PROVIDER=
KYC_PROVIDER_URL=
KYC_PROVIDER_TOKEN=
KYC_PROVIDER_API_KEY=

# Logistics
LOGISTICS_PROVIDER=
LOGISTICS_API_URL=
LOGISTICS_API_TOKEN=
LOGISTICS_API_KEY=
LOGISTICS_WEBHOOK_SECRET=

# Notifications. A single gateway can route email/SMS/WhatsApp/push.
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
EMAIL_PROVIDER=
EMAIL_FROM=hello@mwahli.example
EMAIL_API_KEY=
SMS_WHATSAPP_PROVIDER=
SMS_WHATSAPP_API_KEY=
SMS_WHATSAPP_FROM=
PUSH_PROVIDER=
PUSH_API_KEY=

# Maps / calendars
MAPS_PROVIDER=
MAPS_API_KEY=
CALENDAR_INTEGRATION_PROVIDER=
CALENDAR_INTEGRATION_CLIENT_ID=
CALENDAR_INTEGRATION_CLIENT_SECRET=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ANALYTICS_PROVIDER=
ANALYTICS_KEY=
UPTIME_WEBHOOK=

# Worker
WORKER_POLL_MS=10000

# Feature flags
FEATURE_FLAG_LOCAL_COMMERCE=true
FEATURE_FLAG_CREATORS=true
FEATURE_FLAG_TOGETHER=true
FEATURE_FLAG_CARE=true
FEATURE_FLAG_WORK=false
FEATURE_FLAG_CAPSULES=true
FEATURE_FLAG_AGENT_COMMERCE=false

# Development-only demo users. Must be false in production.
DEV_DEMO_ENABLED=true
DEV_DEMO_SHOPPER_EMAIL=shopper@mwahli.local
DEV_DEMO_SHOPPER_PASSWORD=LoveMadeFelt!2026
DEV_DEMO_CREATOR_EMAIL=creator@mwahli.local
DEV_DEMO_CREATOR_PASSWORD=CreateWithCare!2026
DEV_DEMO_OPS_EMAIL=ops@mwahli.local
DEV_DEMO_OPS_PASSWORD=OperateSafely!2026

# Optional dedicated KMS key for object storage server-side encryption.
OBJECT_STORAGE_KMS_KEY_ID=

# Expo mobile public endpoints. These contain no secrets.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000
